(() => {
  'use strict';
  // Server save (release 15.1). One player, no account: the save on the server is
  // the "head"; every version stays in the server history. This device remembers
  // which server revision and which local files it last matched, so it can tell
  // who changed since: this device, another device, or both.
  const byId = id => document.getElementById(id);
  const saves = window.ProbablyStolenSaves;
  const endpoint = (document.querySelector('meta[name="probably-stolen-cloud-save"]')?.content || '').trim().replace(/\/+$/, '');
  const root = saves.storageRoot(location.href);
  const STATE_KEY = 'probably-stolen-cloud-v1';
  const POLL_MS = 20000;
  const status = byId('cloud-status'), launchStatus = byId('cloud-launch-status');
  const historySelect = byId('cloud-history'), restoreButton = byId('cloud-restore'), syncButton = byId('cloud-sync-now');
  let started = false, busy = null, stopped = false, timer = null, lastHead;

  function readState() {
    try { const value = JSON.parse(localStorage.getItem(STATE_KEY)); return value && typeof value === 'object' ? value : {}; }
    catch (_) { return {}; }
  }
  function writeState(value) {
    try { localStorage.setItem(STATE_KEY, JSON.stringify(value)); } catch (_) { /* The next sync compares again. */ }
  }
  function say(text, {launch = false} = {}) {
    status.textContent = text;
    if (launch) { launchStatus.textContent = text; launchStatus.hidden = !text; }
  }
  function deviceName() {
    const ua = navigator.userAgent;
    const os = /iPhone/.test(ua) ? 'iPhone' : /iPad/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1) ? 'iPad'
      : /Android/.test(ua) ? 'Android' : /Windows/.test(ua) ? 'Windows' : /Macintosh/.test(ua) ? 'Mac' : /Linux/.test(ua) ? 'Linux' : 'Máy khác';
    const browser = /Edg\//.test(ua) ? 'Edge' : /CriOS|Chrome\//.test(ua) ? 'Chrome' : /FxiOS|Firefox\//.test(ua) ? 'Firefox' : /Safari\//.test(ua) ? 'Safari' : '';
    return browser ? `${os} · ${browser}` : os;
  }
  function describe(manifest) {
    const days = (manifest?.summary || []).map(item => `ô ${item.slot + 1}: ngày ${item.day}`).join(', ');
    const when = manifest?.updatedAt ? new Date(manifest.updatedAt).toLocaleString('vi-VN', {dateStyle: 'short', timeStyle: 'short'}) : '';
    return [days || 'chưa rõ ngày', when && `lúc ${when}`, manifest?.device && `từ ${manifest.device}`].filter(Boolean).join(' · ');
  }

  async function api(path, {method = 'GET', body, raw, timeout = 15000} = {}) {
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), timeout);
    try {
      const response = await fetch(endpoint + path, {
        method, signal: controller.signal, cache: 'no-store',
        headers: raw ? {'Content-Type': 'application/octet-stream'} : body ? {'Content-Type': 'application/json'} : undefined,
        body: raw || (body ? JSON.stringify(body) : undefined),
      });
      if (path.startsWith('/v1/blobs/') && method === 'GET') {
        if (!response.ok) throw Object.assign(new Error('Server thiếu dữ liệu save.'), {status: response.status});
        return new Uint8Array(await response.arrayBuffer());
      }
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw Object.assign(new Error(data.error || `Server trả lỗi ${response.status}.`), {status: response.status, data});
      return data;
    } catch (error) {
      if (error.name === 'AbortError') throw Object.assign(new Error('Server không phản hồi.'), {offline: true});
      if (error instanceof TypeError) throw Object.assign(new Error('Chưa kết nối được server.'), {offline: true});
      throw error;
    } finally { clearTimeout(timeoutId); }
  }
  async function getHead() {
    try { return lastHead = await api('/v1/head'); }
    catch (error) { if (error.status === 404) return lastHead = null; throw error; }
  }

  async function digestOf(files) {
    const sorted = [...files].sort((a, b) => a.name < b.name ? -1 : a.name > b.name ? 1 : 0);
    return saves.hash(new TextEncoder().encode(sorted.map(file => `${file.name}:${file.sha256}\n`).join('')));
  }
  async function readLocal() {
    const files = await saves.readFiles(root);
    for (const file of files) file.sha256 = await saves.hash(file.bytes);
    const playable = files.some(file => file.name === 'saves_index.es3') && files.some(file => /^save_\d+\.es3$/.test(file.name));
    return {files, playable, digest: playable ? await digestOf(files) : '', summary: playable ? saves.describe(files) : []};
  }

  async function sendBlobs(local, known) {
    for (const file of local.files) {
      if (known.has(file.sha256)) continue;
      await api('/v1/blobs/' + file.sha256, {method: 'PUT', raw: file.bytes, timeout: 60000});
      known.add(file.sha256);
    }
  }
  function manifestBody(local, extra = {}) {
    return {device: deviceName(), summary: local.summary, buildVersion: window.ProbablyStolenBuildVersion || '',
      files: local.files.map(file => ({name: file.name, size: file.bytes.length, sha256: file.sha256})), ...extra};
  }
  async function upload(local, base) {
    // Corrupt or half-written local files must never become the server save.
    await saves.createArchive(local.files, 'cloud-check');
    const known = new Set((lastHead?.files || []).map(file => file.sha256));
    await sendBlobs(local, known);
    const head = await api('/v1/head', {method: 'PUT', body: manifestBody(local, {base})});
    lastHead = head;
    writeState({revision: head.revision, digest: local.digest});
    return head;
  }
  async function snapshot(local) {
    if (!local.playable) return null;
    await saves.createArchive(local.files, 'cloud-check');
    await sendBlobs(local, new Set((lastHead?.files || []).map(file => file.sha256)));
    return api('/v1/snapshots', {method: 'POST', body: manifestBody(local)});
  }
  function toBase64(bytes) {
    let text = '';
    for (let i = 0; i < bytes.length; i += 16384) text += String.fromCharCode(...bytes.subarray(i, i + 16384));
    return btoa(text);
  }
  async function download(manifest) {
    const files = [];
    for (const file of manifest.files) {
      const bytes = await api('/v1/blobs/' + file.sha256, {timeout: 60000});
      files.push({name: file.name, size: bytes.length, sha256: await saves.hash(bytes), data: toBase64(bytes)});
    }
    const archive = {format: 'probably-stolen-save-backup', version: 1, createdAt: manifest.updatedAt, buildVersion: 'cloud', files};
    // replaceArchive checks every hash and save before it touches local data.
    await saves.replaceArchive(root, JSON.stringify(archive));
  }

  function ask(text, primary, secondary) {
    return new Promise(resolve => {
      const panel = byId('cloud-choice'), first = byId('cloud-choice-primary'), second = byId('cloud-choice-secondary');
      byId('cloud-choice-text').textContent = text;
      first.textContent = primary; second.textContent = secondary;
      const done = value => () => { panel.hidden = true; first.onclick = second.onclick = null; resolve(value); };
      first.onclick = done('primary'); second.onclick = done('secondary');
      panel.hidden = false;
      first.focus();
    });
  }

  async function beforePlayInner() {
    if (!endpoint) { say('Chưa cấu hình server lưu save; save chỉ nằm trên máy này.'); return; }
    say('Đang kiểm tra save trên server…', {launch: true});
    const local = await readLocal();
    let head;
    try { head = await getHead(); }
    catch (error) {
      say(`${error.message} Save vẫn lưu trên máy này và sẽ gửi lên khi có mạng.`, {launch: true});
      return;
    }
    const state = readState();
    if (!head) {
      say(local.playable ? 'Server chưa có save; sẽ gửi save của máy này lên khi game chạy.' : 'Server chưa có save. Save sẽ được gửi lên sau khi game lưu lần đầu.', {launch: true});
      return;
    }
    if (local.playable && head.digest === local.digest) {
      writeState({revision: head.revision, digest: local.digest});
      say('Save trên máy này giống save trên server.', {launch: true});
      return;
    }
    const serverChanged = head.revision !== state.revision;
    const localChanged = local.playable && local.digest !== state.digest;
    if (!serverChanged) {
      say(localChanged ? 'Save trên máy này mới hơn; sẽ gửi lên server khi game chạy.' : 'Save đã khớp server.', {launch: true});
      return;
    }
    let choice = 'primary';
    if (local.playable) {
      const text = localChanged
        ? `Save trên server và trên máy này khác nhau.\nServer: ${describe(head)}.\nMáy này: ${describe({summary: local.summary})}.\nChọn save để chơi tiếp. Bản không chọn vẫn được giữ trong danh sách bản cũ trên server.`
        : `Save trên server mới hơn: ${describe(head)}.\nMáy này: ${describe({summary: local.summary})}.`;
      choice = await ask(text, localChanged ? 'Dùng save trên server' : 'Tải save từ server', localChanged ? 'Dùng save trên máy này' : 'Giữ save trên máy này');
    }
    if (choice === 'primary') {
      say('Đang tải save từ server…', {launch: true});
      if (local.playable) await snapshot(local); // Keep the replaced local save on the server.
      await download(head);
      writeState({revision: head.revision, digest: head.digest});
      say(`Đã tải save từ server (${describe(head)}).`, {launch: true});
    } else {
      say('Đang gửi save của máy này lên server…', {launch: true});
      await upload(local, head.revision);
      say('Đã gửi save của máy này lên server. Bản trước đó vẫn nằm trong danh sách bản cũ.', {launch: true});
    }
  }

  async function syncNow(reason) {
    if (!endpoint || stopped || !started) return;
    if (busy) return busy;
    busy = (async () => {
      const local = await readLocal();
      if (!local.playable) return;
      const state = readState();
      if (local.digest === state.digest) return;
      try {
        if (lastHead === undefined) await getHead();
        const head = await upload(local, state.revision ?? lastHead?.revision ?? null);
        say(`Đã lưu save lên server (${describe(head)}).`);
      } catch (error) {
        if (error.status === 409) {
          // Another device changed the server save while this one was playing.
          stopped = true;
          await getHead().catch(() => {});
          await snapshot(local).catch(() => {});
          say('Save trên server vừa bị máy khác thay đổi. Save của máy này đã được cất vào danh sách bản cũ; tự đồng bộ tạm dừng. Đóng rồi mở lại game để chọn save.');
        } else if (error.offline) {
          say(`${error.message} Sẽ thử gửi save lại sau.`);
        } else {
          say('Chưa lưu được save lên server: ' + error.message);
        }
      }
    })().catch(error => { console.error('Cloud save failed', reason, error); say('Chưa đọc được save để gửi lên server: ' + error.message); })
      .finally(() => { busy = null; });
    return busy;
  }

  async function loadHistory() {
    if (!endpoint) return;
    historySelect.disabled = true;
    try {
      const entries = await api('/v1/history');
      historySelect.replaceChildren(...(entries.length ? entries : [null]).map((entry, index) => {
        const option = document.createElement('option');
        if (!entry) { option.value = ''; option.textContent = 'Chưa có bản lưu nào'; return option; }
        option.value = entry.revision;
        option.textContent = `${index === 0 && entry.kind === 'head' && entry.revision === lastHead?.revision ? 'Hiện tại — ' : ''}${entry.kind === 'snapshot' ? 'Bản cất — ' : ''}${describe(entry)}`;
        return option;
      }));
      historySelect.disabled = !entries.length;
    } catch (error) {
      historySelect.replaceChildren(Object.assign(document.createElement('option'), {value: '', textContent: error.message}));
    }
    restoreButton.disabled = started || historySelect.disabled;
  }

  byId('app-menu').addEventListener('toggle', event => {
    if (!event.target.open) return;
    if (!endpoint) { say('Chưa cấu hình server lưu save; save chỉ nằm trên máy này.'); return; }
    (async () => {
      // The head is read first so the history list can mark the current save.
      if (!started && !busy) {
        try { const head = await getHead(); say(head ? `Save trên server: ${describe(head)}.` : 'Server chưa có save.'); }
        catch (error) { say(error.message); }
      }
      await loadHistory();
    })();
  });
  syncButton.addEventListener('click', async () => {
    if (!endpoint) return;
    if (!started) { say('Save được đồng bộ khi bấm Chơi và trong lúc chơi.'); return; }
    if (stopped) { say('Tự đồng bộ đang tạm dừng vì save trên server đã bị máy khác thay đổi. Đóng rồi mở lại game để chọn save.'); return; }
    syncButton.disabled = true;
    try {
      await window.ProbablyStolenPWA.requestCheckpoint('cloud-save').catch(() => {});
      const before = readState().digest;
      await syncNow('button');
      if (readState().digest === before && !stopped) say('Save trên server đã là bản mới nhất của máy này.');
    } finally { syncButton.disabled = false; }
  });
  restoreButton.addEventListener('click', async () => {
    const revision = historySelect.value;
    if (!revision || started) return;
    restoreButton.disabled = true;
    try {
      await saves.acquireSession();
      say('Đang tải bản lưu đã chọn…');
      const manifest = await api('/v1/history/' + encodeURIComponent(revision));
      await getHead();
      await snapshot(await readLocal()); // The save being replaced stays on the server.
      await download(manifest);
      // Different from the server head on purpose: Play sends it up as the new head.
      writeState({revision: lastHead?.revision ?? null, digest: 'restored'});
      say(`Đã dùng bản lưu ${describe(manifest)}. Bấm Chơi rồi Load Game; bản này sẽ thành save trên server.`);
    } catch (error) {
      say('Chưa khôi phục được: ' + error.message);
    } finally { restoreButton.disabled = started; }
  });

  window.addEventListener('probably-stolen-ready', () => {
    timer = timer || setInterval(() => syncNow('poll'), POLL_MS);
    syncNow('ready');
  });
  window.addEventListener('probably-stolen-visibility', event => {
    if (!event.detail?.hidden || !started) return;
    window.ProbablyStolenPWA.requestCheckpoint('cloud-save').catch(() => {}).then(() => syncNow('hidden'));
  });
  fetch('pwa-build.json').then(response => response.ok ? response.json() : null)
    .then(manifest => { window.ProbablyStolenBuildVersion = manifest?.version || ''; }).catch(() => {});

  window.ProbablyStolenCloud = Object.freeze({
    async beforePlay() {
      try { await beforePlayInner(); }
      catch (error) {
        console.error('Cloud save check failed', error);
        say('Chưa đồng bộ được save với server: ' + error.message + ' Game dùng save trên máy này.', {launch: true});
      }
      started = true;
      restoreButton.disabled = true;
    },
    syncNow,
  });
  if (!endpoint) say('Chưa cấu hình server lưu save; save chỉ nằm trên máy này.');

  // Release 15.2: before Play, show which save the server holds and whether this
  // device matches it, so the player picks "Tải File Mới Nhất" with confidence.
  async function showOnLaunch() {
    if (!endpoint) return;
    const show = text => { if (!started) { launchStatus.textContent = text; launchStatus.hidden = false; } };
    show('Đang xem save trên server…');
    const [head, local] = await Promise.all([
      getHead().catch(error => ({error})),
      readLocal().catch(() => null),
    ]);
    if (head?.error) {
      show(`Chưa xem được save trên server: ${head.error.message}` + (local?.playable ? `\nMáy này: ${describe({summary: local.summary})}.` : ''));
      return;
    }
    const lines = [head ? `Save trên server: ${describe(head)}.` : 'Server chưa có save.'];
    if (local?.playable) lines.push(head && head.digest === local.digest ? 'Máy này: giống save trên server.' : `Máy này: ${describe({summary: local.summary})}.`);
    if (head || local?.playable) lines.push('Vào game: Tải → “Tải File Mới Nhất” để chơi tiếp lần lưu cuối.');
    show(lines.join('\n'));
  }
  showOnLaunch().catch(error => console.error('Cloud launch summary failed', error));
})();
