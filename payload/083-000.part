(() => {
  'use strict';
  const byId = id => document.getElementById(id);
  const canvas = byId('unity-canvas');
  const loadStatus = byId('load-status');
  const offlineStatus = byId('offline-status');
  const offlineButton = byId('offline-button');
  let registration;
  let launching = false;
  let downloading = false;
  let gameHooks = null;
  let checkpointInFlight = null;
  let retryingCheckpoint = false;
  let storageNeedsReload = false;
  let lastStartupError = '';
  let loaderStarted = false; // Unity's loader is running or has run in this page.
  let loadFailed = false;    // ...and failed, so no game state exists in this page.
  let updating = false;
  let updateRequested = false; // This page asked the new version to take over.
  let reloadingForUpdate = false;
  let servedBy = null; // Version of the worker that served this page's shell (null on a first visit).
  const hadController = Boolean(navigator.serviceWorker?.controller);
  window.addEventListener('error', event => { if (launching && !window.unityInstance) lastStartupError = event.message || ''; });
  navigator.serviceWorker?.addEventListener('message', event => {
    if (event.data?.type === 'ASSET_ERROR' && launching && !window.unityInstance)
      lastStartupError = `Không tải được ${event.data.path}: ${event.data.message}`;
  });

  async function requireWorker() {
    let setupTimer;
    try { await Promise.race([workerSetup,new Promise((_,reject)=>{
      setupTimer=setTimeout(()=>reject(new Error('Chưa chuẩn bị được bộ tải. Giữ kết nối mạng rồi thử lại.')),20000);
    })]); } finally { clearTimeout(setupTimer); }
    if (!registration) throw new Error('Chưa chuẩn bị được bộ tải. Hãy giữ kết nối mạng và mở lại ứng dụng.');
    if (!navigator.serviceWorker.controller) await new Promise((resolve,reject) => {
      const changed = () => { if(navigator.serviceWorker.controller) finish(); };
      const timer = setTimeout(()=>finish(new Error('Bộ tải chưa sẵn sàng. Đóng ứng dụng rồi mở lại khi có mạng.')),20000);
      function finish(error) { clearTimeout(timer);navigator.serviceWorker.removeEventListener('controllerchange',changed);error?reject(error):resolve(); }
      navigator.serviceWorker.addEventListener('controllerchange',changed);changed();
    });
    const state=await sendToWorker('OFFLINE_STATUS');
    // A newer worker took over after this page loaded (for example forced from another tab): this page's
    // shell belongs to the old version, so reload into the new one instead of starting an old build.
    if(servedBy && state.version!==servedBy) {
      reloadForUpdate();
      throw Object.assign(new Error('Đang mở bản mới…'), {userAction: true});
    }
    // Best effort and bounded: a stalled network, captive portal or broken response must not block an
    // offline-ready game.
    let published=null;
    if(navigator.onLine) {
      const check=new AbortController(), timer=setTimeout(()=>check.abort(),5000);
      try {
        const response=await fetch('pwa-build.json',{cache:'no-store',signal:check.signal});
        if(response.ok) published=(await response.json())?.version;
      } catch (_) { published=null; } finally { clearTimeout(timer); }
    }
    if(typeof published==='string' && published!==state.version) {
      // The game has not started in this page, so nothing is lost by switching to the new version now.
      loadStatus.textContent = 'Có bản mới. Đang cập nhật…';
      let reloading = false;
      try { reloading = await applyUpdate({ automatic: true }); } catch (_) { reloading = false; }
      if (reloading) throw Object.assign(new Error('Đang mở bản mới…'), {userAction: true});
      throw Object.assign(new Error('Có bản cập nhật. Mở Cài đặt → “Cập nhật bản mới nhất”. Không cần xóa save.'), {userAction: true});
    }
  }

  // ---- Updates (release 14) ----
  // A new version installs in the background but, by design, only takes over once every window of the
  // game is closed, so a reload (F5) alone keeps the old version. These helpers let the page ask the
  // waiting worker to take over now, then reload into the new version.
  const updateButton = byId('update-button');
  const updateStatus = byId('update-status');
  const gameStarted = () => Boolean(window.unityInstance || (loaderStarted && !loadFailed));
  const offlineButtonEl = byId('offline-button');

  function reloadForUpdate() {
    if (reloadingForUpdate) return;
    reloadingForUpdate = true;
    window.location.reload();
  }

  // The new version may take over later than asked: a browser waits until the old worker finishes its
  // background work (for example storing music). Reload then if this page asked for it, or if nothing has
  // started here yet; a running game is left alone and told that the new version is ready.
  navigator.serviceWorker?.addEventListener('controllerchange', () => {
    if (updateRequested || (hadController && !gameStarted() && !launching && !downloading)) reloadForUpdate();
    else if (hadController && gameStarted()) updateStatus.textContent = 'Bản mới đã sẵn sàng. Lưu trong game rồi tải lại trang khi tiện.';
  });
  const shortVersion = version => typeof version === 'string' ? version.slice(0, 8) : '?';

  function showUpdateTip() { byId('update-tip').hidden = !registration?.waiting; }

  function untilState(worker, ms) {
    return new Promise((resolve, reject) => {
      const done = () => ['installed', 'activating', 'activated', 'redundant'].includes(worker.state);
      const timer = setTimeout(() => finish(new Error('Tải bản mới quá lâu. Kiểm tra mạng rồi thử lại.')), ms);
      const changed = () => { if (done()) finish(); };
      function finish(error) { clearTimeout(timer); worker.removeEventListener('statechange', changed); error ? reject(error) : resolve(); }
      worker.addEventListener('statechange', changed); changed();
    });
  }

  // Returns the installed new version's worker, asking the server first; null when there is none.
  async function findNewWorker() {
    if (registration.waiting) return registration.waiting;
    await registration.update();
    const worker = registration.installing || registration.waiting;
    if (worker) await untilState(worker, 3 * 60 * 1000);
    return registration.waiting;
  }

  function askWorker(worker, data) {
    return new Promise((resolve, reject) => {
      const channel = new MessageChannel();
      const timer = setTimeout(() => finish(new Error('Bản mới chưa hỗ trợ cập nhật nhanh. Đóng mọi cửa sổ game rồi mở lại.')), 10000);
      function finish(error, result) { clearTimeout(timer); channel.port1.close(); error ? reject(error) : resolve(result); }
      channel.port1.onmessage = ({ data: reply }) => { if (reply?.type === data.type) finish(null, reply); };
      worker.postMessage(data, [channel.port2]);
    });
  }

  function untilControllerChange(ms) {
    return new Promise(resolve => {
      const timer = setTimeout(() => done(false), ms);
      const changed = () => done(true);
      function done(result) { clearTimeout(timer); navigator.serviceWorker.removeEventListener('controllerchange', changed); resolve(result); }
      navigator.serviceWorker.addEventListener('controllerchange', changed);
    });
  }

  // Resolves once the game's latest checkpoint is on the device; rejects if that cannot be confirmed.
  async function flushBeforeUpdate() {
    let timer;
    try {
      await Promise.race([window.ProbablyStolenPWA.requestCheckpoint('update'),
        new Promise((_, reject) => { timer = setTimeout(() => reject(new Error('timeout')), 20000); })]);
    } finally { clearTimeout(timer); }
  }

  // automatic: never interrupts a started game and never asks; returns true when the page is reloading.
  async function applyUpdate({ automatic = false } = {}) {
    if (updating || !registration) return false;
    updating = true;
    offlineButtonEl.disabled = true; // A reload or the new version's cleanup would cut an offline download.
    let reloading = false;
    try {
      const worker = await findNewWorker();
      showUpdateTip();
      if (!worker) return false;
      // The new version deletes the old version's offline files when it takes over; without a network
      // the player could then not play at all, so never switch while offline.
      if (!navigator.onLine) { updateStatus.textContent = 'Cần kết nối mạng để cập nhật. Bản hiện tại vẫn chơi được.'; return false; }
      if (gameStarted()) {
        if (automatic) return false;
        if (!window.confirm('Game sẽ tải lại để cập nhật. Phần chơi chưa lưu sẽ mất. Cập nhật ngay?')) return false;
        updateStatus.textContent = 'Đang ghi điểm lưu xuống thiết bị…';
        try { await flushBeforeUpdate(); }
        catch (_) {
          updateStatus.textContent = 'Chưa ghi xong điểm lưu xuống thiết bị nên chưa cập nhật. Đợi vài giây rồi bấm lại.';
          return false;
        }
      }
      let reply = await askWorker(worker, { type: 'SKIP_WAITING' });
      if (!reply.applied && reply.otherWindows && !automatic &&
          window.confirm(`Game đang mở ở ${reply.otherWindows} cửa sổ/tab khác. Cập nhật có thể làm các cửa sổ đó lỗi. Vẫn cập nhật?`))
        reply = await askWorker(worker, { type: 'SKIP_WAITING', force: true });
      if (!reply.applied) {
        if (reply.otherWindows) updateStatus.textContent = 'Có bản mới. Đóng các tab/cửa sổ game khác rồi bấm lại.';
        else if (reply.error) updateStatus.textContent = 'Chưa cập nhật được: ' + reply.error;
        return false;
      }
      updateRequested = true; // From here the controllerchange listener reloads, however late it comes.
      reloading = true;
      updateStatus.textContent = 'Đang mở bản mới…';
      const switched = navigator.serviceWorker.controller === worker || await untilControllerChange(15000);
      if (switched) { reloadForUpdate(); return true; }
      // The old version is still finishing background work; the browser switches when it is done.
      updateStatus.textContent = 'Bản mới sẽ tự mở khi bản cũ tải xong phần đang dở (có thể vài phút). Không cần làm gì thêm.';
      setTimeout(reloadForUpdate, 5 * 60 * 1000); // Then setupPWA finishes the switch if it is still pending.
      return true;
    } finally {
      if (!reloading) { updating = false; refreshOfflineStatus(); }
    }
  }

  updateButton.addEventListener('click', async () => {
    if (updating) { if (!updateRequested) updateStatus.textContent = 'Đang kiểm tra bản mới…'; return; }
    if (downloading) { updateStatus.textContent = 'Đang tải nội dung offline. Đợi tải xong rồi cập nhật.'; return; }
    if (launching && !window.unityInstance && !loadFailed) { updateStatus.textContent = 'Game đang mở. Đợi vào game xong rồi cập nhật.'; return; }
    updateButton.disabled = true;
    updateStatus.textContent = 'Đang kiểm tra bản mới…';
    try {
      if (!registration) throw new Error('Trình duyệt này chưa bật được bộ tải offline.');
      if (await applyUpdate()) return;
      if (registration.waiting) {
        if (updateStatus.textContent === 'Đang kiểm tra bản mới…') updateStatus.textContent = 'Đã hủy. Bấm lại khi muốn cập nhật.';
        return;
      }
      const state = await sendToWorker('OFFLINE_STATUS');
      const response = await fetch('pwa-build.json', { cache: 'no-store' });
      const published = response.ok ? (await response.json())?.version : null;
      updateStatus.textContent = typeof published === 'string' && published !== state.version
        ? 'Máy chủ có bản mới nhưng chưa tải về được. Kiểm tra mạng rồi thử lại.'
        : `Bạn đang dùng bản mới nhất (mã ${shortVersion(state.version)}).`;
    } catch (error) {
      updateStatus.textContent = navigator.onLine ? 'Chưa kiểm tra được bản mới: ' + error.message
        : 'Cần kết nối mạng để kiểm tra bản mới.';
    } finally { updateButton.disabled = false; }
  });

  // The game must register real save/visibility hooks. This shell never claims a save occurred.
  window.ProbablyStolenPWA = Object.freeze({
    registerGameHooks(hooks) { gameHooks = hooks; },
    async requestCheckpoint(reason = 'manual') {
      if (!gameHooks?.checkpoint) return { supported: false };
      if (!checkpointInFlight) checkpointInFlight = Promise.resolve()
        .then(() => gameHooks.checkpoint(reason)).then(() => ({ supported: true }))
        .finally(() => { checkpointInFlight = null; });
      return checkpointInFlight;
    },
  });

  function showSaveFailure(event) {
    storageNeedsReload = event?.detail?.phase === 'hydrate';
    byId('save-warning-message').textContent = storageNeedsReload
      ? 'Chưa đọc được dữ liệu lưu trên thiết bị. Hãy tải lại game để thử lại.'
      : 'Chưa ghi được điểm lưu gần nhất xuống thiết bị. Giữ game mở và thử đồng bộ lại.';
    if (!retryingCheckpoint) byId('save-retry-button').textContent = storageNeedsReload ? 'Tải lại game' : 'Thử đồng bộ lại';
    byId('save-warning').hidden = false;
    byId('save-sync-status').textContent = '';
  }
  window.addEventListener('probably-stolen-save-error', showSaveFailure);
  byId('save-retry-button').addEventListener('click', async () => {
    if (retryingCheckpoint) return;
    if (storageNeedsReload) { window.location.reload(); return; }
    retryingCheckpoint = true;
    const button = byId('save-retry-button');
    button.disabled = true;
    button.textContent = 'Đang đồng bộ…';
    try {
      const result = await window.ProbablyStolenPWA.requestCheckpoint('manual-retry');
      if (result.supported) {
        byId('save-warning').hidden = true;
        byId('save-sync-status').textContent = 'Đã đồng bộ điểm lưu gần nhất xuống thiết bị.';
      } else {
        byId('save-warning-message').textContent = 'Bản game chưa sẵn sàng đồng bộ dữ liệu. Hãy thử lại sau khi game tải xong.';
      }
    } catch (error) {
      console.error('Checkpoint retry failed', error);
      showSaveFailure();
    } finally {
      retryingCheckpoint = false;
      button.disabled = false;
      button.textContent = 'Thử đồng bộ lại';
    }
  });

  function resize() {
    document.documentElement.style.setProperty('--viewport-height', `${window.visualViewport?.height || window.innerHeight}px`);
  }
  window.addEventListener('resize', resize);
  window.visualViewport?.addEventListener('resize', resize);
  resize();

  document.addEventListener('visibilitychange', () => {
    const hidden = document.hidden;
    gameHooks?.visibility?.(hidden);
    window.dispatchEvent(new CustomEvent('probably-stolen-visibility', { detail: { hidden } }));
    if (hidden) window.ProbablyStolenPWA.requestCheckpoint('hidden').catch(error => {
      console.error('Checkpoint failed', error);
      window.dispatchEvent(new CustomEvent('probably-stolen-save-error'));
    });
    else refreshOfflineStatus();
  });

  byId('play-button').addEventListener('click', async () => {
    if (updating) { loadStatus.textContent = 'Đang cập nhật bản mới…'; return; }
    if (launching || downloading) return;
    launching = true;
    let fetchDataWithProgress, wasmLoader;
    const downloads = new AbortController(); // Stops the other transfer once startup has failed.
    try {
      if(!window.ProbablyStolenSaveUI) throw new Error('Chưa tải đủ giao diện. Hãy tải lại ứng dụng.');
      // A busy backup is an instruction to the player, not a startup failure.
      await window.ProbablyStolenSaveUI.prepareToPlay();
    } catch (error) { launching = false; loadStatus.textContent = error.message; return; }
    try {
      if(window.unityBuild.requiresWorker) {
        loadStatus.textContent = 'Đang kiểm tra bộ tải…';
        await requireWorker();
        // Journal from here on; a pending-update notice must not replace the previous real report.
        window.ProbablyStolenStartup.begin(window.unityBuild.config.dataUrl);
        window.ProbablyStolenStartup.phase('Chuẩn bị bộ tải');
        const build = await sendToWorker('UNITY_DATA_MANIFEST');
        fetchDataWithProgress = window.ProbablyStolenDownloads.createDataFetcher(build, window.unityBuild.config.dataUrl, {signal: downloads.signal});
        if (build.virtualFiles?.some(file => new URL(file.url, location.href).href === new URL(window.unityBuild.config.codeUrl, location.href).href))
          wasmLoader = window.ProbablyStolenDownloads.createWasmLoader(build, window.unityBuild.config.codeUrl, {signal: downloads.signal});
      }
    }
    catch (error) {
      launching = false;
      loadStatus.textContent = error.message;
      if (!error.userAction) {
        window.ProbablyStolenStartup.begin(window.unityBuild.config.dataUrl); // Record loader preparation failures too.
        window.ProbablyStolenStartup.fail(error);
      }
      return;
    }
    if (!window.unityBuild.requiresWorker) window.ProbablyStolenStartup.begin(window.unityBuild.config.dataUrl);
    byId('play-button').hidden = true;
    byId('load-progress').hidden = false;
    loadStatus.textContent = 'Đang tải game…';
    byId('load-error-details').hidden = true;
    const script = document.createElement('script');
    script.src = window.unityBuild.loaderUrl;
    let failed = false;
    const fail = error => {
      if (failed) return;
      failed = true;
      loadFailed = true;
      downloads.abort();
      console.error('Game loading failed', error);
      loadStatus.textContent = 'Chưa mở được game. Xem chi tiết bên dưới rồi thử lại.';
      const reason = error?.message || (typeof error === 'string' ? error : `Không tải được bộ khởi động: ${script.src}`);
      if (lastStartupError && reason.includes(lastStartupError)) lastStartupError = '';
      window.ProbablyStolenStartup.fail([reason, lastStartupError].filter(Boolean).join('\n'));
      byId('load-error-message').textContent = [reason,lastStartupError,`Chế độ: ${window.matchMedia('(display-mode: standalone)').matches || navigator.standalone ? 'Ứng dụng' : 'Trình duyệt'}`].filter(Boolean).join('\n').slice(0,2000);
      byId('load-error-details').hidden = false;
      byId('load-error-details').open = true;
      byId('load-progress').hidden = true;
      byId('retry-button').hidden = false;
    };
    script.onerror = fail;
    script.onload = async () => {
      try {
        loadStatus.textContent = 'Đang nạp dữ liệu game…';
        window.ProbablyStolenStartup.phase('Nạp dữ liệu game');
        let initializingScene = false;
        const starting = createUnityInstance(canvas, {
          ...window.unityBuild.config,
          ...(fetchDataWithProgress ? {fetchDataWithProgress} : {}),
          ...(wasmLoader ? {instantiateWasm: wasmLoader.instantiateWasm} : {}),
          matchWebGLToCanvasSize: false,
          // Retina phones otherwise render up to nine pixels per CSS pixel.
          // Keep readable text without paying that full fill-rate/framebuffer cost.
          devicePixelRatio: window.ProbablyStolenGraphics.pixelRatio(),
          print(message) {
            console.log(message);
            if (String(message).startsWith('Loading player data')) {
              initializingScene = true;
              window.ProbablyStolenStartup.phase('Khởi tạo cảnh game');
            }
          },
          showBanner(message, type) {
            if (type !== 'error') return;
            lastStartupError=message;loadStatus.textContent = message;
            // e.g. framework.js could not load: the loader never settles, so end the attempt visibly.
            if (!window.unityInstance) fail(new Error(message));
          },
        }, progress => {
          lastStartupError = ''; // A later part arrived: an earlier transient transfer error is not the cause.
          byId('load-progress').value = progress;
          if (!initializingScene) window.ProbablyStolenStartup.phase('Nạp dữ liệu game', progress);
        });
        // A WASM transfer failure happens inside Emscripten; surface its real reason.
        window.unityInstance = await (wasmLoader ? Promise.race([starting, wasmLoader.failure]) : starting);
        window.ProbablyStolenStartup.ready(window.unityInstance);
        byId('launch-panel').hidden = true;
        canvas.focus();
        window.dispatchEvent(new CustomEvent('probably-stolen-ready'));
        await refreshOfflineStatus();
      } catch (error) { fail(error); }
    };
    loaderStarted = true;
    document.body.append(script);
  });
  byId('retry-button').addEventListener('click', () => window.location.reload());

  function sendToWorker(type, progress) {
    const worker = navigator.serviceWorker.controller || registration?.active;
    if (!worker) return Promise.reject(new Error('Chưa có bản offline đang hoạt động.'));
    return new Promise((resolve, reject) => {
      const channel = new MessageChannel();
      let timeout;
      const armTimeout = () => { clearTimeout(timeout);timeout=setTimeout(()=>finish(new Error('Lượt tải mất quá nhiều thời gian. Hãy thử lại.')),type==='OFFLINE_DOWNLOAD'?10*60*1000:20000); };
      function finish(error, result) {
        clearTimeout(timeout);
        channel.port1.close();
        if (error) reject(error); else resolve(result);
      }
      channel.port1.onmessage = ({ data }) => {
        if (data.type === 'OFFLINE_PROGRESS') { armTimeout();progress?.(data); }
        else if (data.type === 'OFFLINE_ERROR') finish(new Error(data.message));
        else if (data.type === 'OFFLINE_STATUS' || data.type === 'UNITY_DATA_MANIFEST') finish(null, data);
      };
      armTimeout();worker.postMessage({ type }, [channel.port2]);
    });
  }

  function renderOfflineStatus(state) {
    if(state.ready) { byId('offline-progress').value=1;byId('offline-transfer').textContent='100% · Đã tải đủ'; }
    offlineStatus.textContent = state.ready
      ? 'Nội dung cần thiết đã tải đủ để chơi offline trên thiết bị này.'
      : 'Nội dung offline chưa tải đủ. Cần kết nối mạng để tải phần còn lại.';
    const size = state.bytes >= 1e9 ? `${(state.bytes / 1e9).toFixed(2)} GB` : `${Math.ceil(state.bytes / 1e6)} MB`;
    offlineButton.textContent = state.ready ? 'Đã sẵn sàng offline' : `Tải để chơi offline · ${size}`;
    offlineButton.disabled = state.ready || updating;
  }

  async function refreshOfflineStatus() {
    if (!registration || downloading) return;
    try { renderOfflineStatus(await sendToWorker('OFFLINE_STATUS')); }
    catch (_) { offlineStatus.textContent = 'Chưa kiểm tra được nội dung offline. Bạn vẫn có thể chơi khi có mạng.'; }
  }

  offlineButton.addEventListener('click', async () => {
    if (downloading || updating || (launching && !window.unityInstance)) return;
    downloading = true;
    byId('play-button').disabled = true;
    byId('offline-progress').hidden = false;
    byId('offline-progress').value = 0;
    byId('offline-transfer').hidden = false;
    byId('offline-transfer').textContent = 'Đang kiểm tra dữ liệu đã tải…';
    offlineButton.disabled = true;
    offlineStatus.textContent = 'Đang tải nội dung. Hãy giữ cửa sổ này mở…';
    try {
      renderOfflineStatus(await sendToWorker('OFFLINE_DOWNLOAD', progress => {
        offlineStatus.textContent = `Đang chuẩn bị nội dung offline · ${progress.complete}/${progress.total}`;
        const ratio = progress.totalBytes ? progress.completedBytes/progress.totalBytes : progress.complete/progress.total;
        byId('offline-progress').value = Math.min(1,ratio);
        byId('offline-transfer').textContent = Number.isFinite(progress.totalBytes)
          ? `${Math.floor(ratio*100)}% · ${(progress.completedBytes/1e6).toFixed(1)} / ${(progress.totalBytes/1e6).toFixed(1)} MB · ${((progress.bytesPerSecond||0)/1e6).toFixed(2)} MB/s`
          : `${Math.floor(ratio*100)}% · ${progress.complete}/${progress.total} tệp`;
      }));
    } catch (error) {
      console.error('Offline download incomplete', error);
      offlineStatus.textContent = 'Chưa tải đủ nội dung offline. Kiểm tra mạng và dung lượng trống, rồi thử lại.';
      offlineButton.disabled = false;
      offlineButton.textContent = 'Tiếp tục tải offline';
    } finally { downloading = false;byId('play-button').disabled=false; }
  });

  async function setupPWA() {
    if (window.matchMedia('(display-mode: standalone)').matches || navigator.standalone) byId('install-tip').hidden = true;
    if (!('serviceWorker' in navigator) || !window.isSecureContext) {
      offlineStatus.textContent = 'Chế độ offline cần trình duyệt hỗ trợ và kết nối HTTPS.';
      return;
    }
    try {
      registration = await navigator.serviceWorker.register('sw.js', { scope: './', updateViaCache: 'none' });
      await navigator.serviceWorker.ready;
      registration.addEventListener('updatefound', () => registration.installing?.addEventListener('statechange', showUpdateTip));
      showUpdateTip();
      if (hadController) try { servedBy = (await sendToWorker('OFFLINE_STATUS')).version; } catch (_) { servedBy = null; }
      // A version installed during an earlier visit is waiting: switch to it before the player starts,
      // at most once a minute (counted from the last attempt) so a failed takeover can never loop reloads.
      if (registration.waiting && navigator.onLine && !gameStarted() && !launching) {
        let recent = false;
        try { recent = Date.now() - Number(sessionStorage.getItem('ps-auto-update') || 0) < 60000;
          if (!recent) sessionStorage.setItem('ps-auto-update', String(Date.now())); } catch (_) { /* Storage blocked: still try. */ }
        if (!recent && await applyUpdate({ automatic: true }).catch(() => false)) return;
      }
      await refreshOfflineStatus();
    } catch (error) {
      console.warn('Offline setup unavailable', error);
      offlineStatus.textContent = 'Chế độ offline chưa sẵn sàng ở bản này. Bạn vẫn có thể chơi khi có mạng.';
    }
  }
  const workerSetup = setupPWA();
})();
