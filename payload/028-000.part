(() => {
  'use strict';
  const byId=id=>document.getElementById(id), saves=window.ProbablyStolenSaves;
  const status=byId('backup-status'), input=byId('backup-file'), confirm=byId('backup-confirm');
  let busy=false, started=false, ready=false, candidate=null, downloadUrl=null, downloadFile=null;
  const root=saves.storageRoot(location.href);
  function buttons() {
    byId('backup-export').disabled=busy || (started && !ready);
    input.disabled=busy || started || !navigator.locks;
    confirm.disabled=busy || started;
    byId('backup-cancel').disabled=busy;
  }
  function clearCandidate() { candidate=null;input.value='';byId('backup-preview').hidden=true; }
  async function operate(action) {
    if(busy) return;
    busy=true;buttons();
    try { await action(); }
    catch(error) { status.textContent=error.message || 'Chưa xử lý được bản sao. Hãy thử lại.'; }
    finally { busy=false;buttons(); }
  }
  window.ProbablyStolenSaveUI=Object.freeze({async prepareToPlay() {
    if(busy) throw new Error('Hãy đợi thao tác sao lưu hoàn tất rồi bấm Chơi.');
    busy=true;buttons();
    try {
      if(navigator.locks) await saves.acquireSession();
      started=true;clearCandidate();
      byId('backup-import-hint').textContent='Để nhập bản sao, đóng rồi mở lại ứng dụng và chọn file trước khi bấm Chơi.';
    } finally {busy=false;buttons();}
  }});
  window.addEventListener('probably-stolen-ready',()=>{ready=true;buttons();});
  byId('backup-export').addEventListener('click',()=>operate(async()=>{
    byId('backup-download').hidden=true;byId('backup-share').hidden=true;
    status.textContent='Đang chuẩn bị bản sao điểm lưu gần nhất…';
    await saves.acquireSession();
    if(started) {
      const result=await window.ProbablyStolenPWA.requestCheckpoint('backup-export');
      if(!result.supported) throw new Error('Game chưa sẵn sàng đồng bộ save.');
    }
    const files=await saves.readFiles(root);
    if(!files.some(file=>/^save_\d+\.es3$/.test(file.name))) throw new Error('Chưa có điểm lưu để sao lưu. Hãy tạo game hoặc hoàn thành một ngày trước.');
    const manifest=await fetch('pwa-build.json').then(response=>response.ok?response.json():null).catch(()=>null);
    const archive=await saves.createArchive(files,manifest?.version || 'unknown');
    downloadFile=new File([JSON.stringify(archive)],'probably-stolen-'+new Date().toISOString().slice(0,10)+'.pssave.json',{type:'application/json'});
    if(downloadUrl) URL.revokeObjectURL(downloadUrl);
    downloadUrl=URL.createObjectURL(downloadFile);
    const link=byId('backup-download');link.href=downloadUrl;link.download=downloadFile.name;link.hidden=false;
    byId('backup-share').hidden=!(navigator.canShare?.({files:[downloadFile]}));
    status.textContent=`Đã chuẩn bị ${files.length} file save. Bấm “Lưu bản sao” để giữ file trên thiết bị.`;
  }));
  byId('backup-share').addEventListener('click',async()=>{
    try { await navigator.share({files:[downloadFile],title:'Probably Stolen — bản sao save'}); }
    catch(error) { if(error.name!=='AbortError') status.textContent='Chưa chia sẻ được file. Bạn có thể bấm Lưu bản sao.'; }
  });
  input.addEventListener('change',()=>{
    const file=input.files?.[0];clearCandidate();if(!file) return;
    operate(async()=>{
      if(started) throw new Error('Hãy mở lại ứng dụng để nhập bản sao trước khi bấm Chơi.');
      if(file.size>saves.MAX_TEXT) throw new Error('Bản sao vượt giới hạn 48 MB.');
      await saves.acquireSession();
      status.textContent='Đang kiểm tra bản sao…';
      const text=await file.text(), parsed=await saves.validateArchive(text);
      candidate=text;
      byId('backup-preview-text').textContent=`Bản sao có ${parsed.files.length} file (${Math.ceil(parsed.totalBytes/1024)} KB). Nhập sẽ thay thế toàn bộ save và lịch sử save trên địa chỉ này. Hãy xuất bản sao hiện tại trước nếu muốn giữ lại.`;
      byId('backup-preview').hidden=false;
      status.textContent='File hợp lệ. Chưa thay đổi save hiện có.';
    });
  });
  confirm.addEventListener('click',()=>operate(async()=>{
    if(started || !candidate) throw new Error('Hãy chọn lại bản sao trước khi mở game.');
    await saves.acquireSession();
    await saves.replaceArchive(root,candidate);
    clearCandidate();
    status.textContent='Đã nhập bản sao. Bấm Chơi, rồi chọn Load Game để tiếp tục.';
  }));
  byId('backup-cancel').addEventListener('click',()=>{clearCandidate();status.textContent='Đã hủy nhập; save hiện có được giữ nguyên.';});
  if(!navigator.locks) byId('backup-import-hint').textContent='Cần cập nhật trình duyệt/iOS để dùng sao lưu và khôi phục.';
  buttons();
})();
