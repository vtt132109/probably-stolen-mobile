(() => {
  'use strict';
  const bar = document.getElementById('mobile-controls');
  const canvas = document.getElementById('unity-canvas');
  const enabled = document.getElementById('touch-controls-enabled');
  const active = new Map();
  const nativePointers = new Set();
  let nativeMouseHeld = false;
  let bridgeReady = false;
  // Keep the full game area clear. Extra actions remain available on demand.
  enabled.checked = false;

  const connected = () => bridgeReady && typeof window.unityInstance?.SendMessage === 'function';
  function send(method, action = '') {
    if (connected()) window.unityInstance.SendMessage('ProbablyStolenMobileInput', method, action);
  }
  function renderPressed() {
    for (const button of bar.querySelectorAll('[data-game-action]')) {
      button.setAttribute('aria-pressed', String([...active.values()].includes(button.dataset.gameAction)));
    }
  }
  function press(source, action) {
    if (active.has(source)) return;
    const alreadyHeld = [...active.values()].includes(action);
    active.set(source, action);
    if (!alreadyHeld) send('PressAction', action);
    renderPressed();
  }
  function release(source) {
    const action = active.get(source);
    if (!action) return;
    active.delete(source);
    if (![...active.values()].includes(action)) send('ReleaseAction', action);
    renderPressed();
  }
  function releaseAll() {
    active.clear();
    nativePointers.clear();
    nativeMouseHeld = false;
    send('ReleaseAll');
    renderPressed();
  }
  function updateControls() {
    const visible = enabled.checked && connected();
    if (!visible && active.size) releaseAll();
    bar.hidden = !visible;
    document.body.classList.toggle('has-mobile-controls', visible);
    window.dispatchEvent(new Event('resize'));
  }
  window.ProbablyStolenInput = Object.freeze({
    // Called by the real C#/.jslib bridge; loading the HTML alone does not enable controls.
    ready() { bridgeReady = true; updateControls(); },
  });
  window.addEventListener('probably-stolen-ready', updateControls);
  window.addEventListener('probably-stolen-visibility', event => { if (event.detail.hidden) releaseAll(); });
  window.addEventListener('blur', releaseAll);
  window.addEventListener('pagehide', releaseAll);
  enabled.addEventListener('change', updateControls);

  const inside = event => !bar.hidden && event.target instanceof Node && bar.contains(event.target);
  const buttonFor = event => event.target instanceof Element ? event.target.closest('[data-game-action]') : null;
  function consume(event) {
    if (event.cancelable) event.preventDefault();
    event.stopImmediatePropagation();
  }
  // Register before the Unity loader. A toolbar touch must not become a Unity primary
  // click, move the native mouse position, or add a simulated second mouse button.
  window.addEventListener('pointerdown', event => {
    if (!inside(event)) {
      if (event.target.id === 'unity-canvas') {
        nativePointers.add(event.pointerId);
        if (event.pointerType === 'mouse') nativeMouseHeld = true;
      }
      return;
    }
    const button = buttonFor(event);
    if (button && event.button === 0) {
      press(`pointer:${event.pointerId}`, button.dataset.gameAction);
      button.setPointerCapture(event.pointerId);
    }
    consume(event);
  }, { capture: true, passive: false });
  for (const type of ['pointerup', 'pointercancel', 'lostpointercapture']) {
    window.addEventListener(type, event => {
      if (nativePointers.delete(event.pointerId)) return;
      const source = `pointer:${event.pointerId}`;
      if (!inside(event) && !active.has(source)) return;
      release(source);
      consume(event);
    }, { capture: true, passive: false });
  }
  window.addEventListener('pointermove', event => {
    if (nativePointers.has(event.pointerId)) return;
    if (inside(event) || active.has(`pointer:${event.pointerId}`)) consume(event);
  }, { capture: true, passive: false });
  for (const type of ['touchstart', 'touchmove', 'touchend', 'touchcancel', 'mousedown', 'mousemove', 'mouseup', 'dblclick', 'contextmenu']) {
    window.addEventListener(type, event => {
      if (type.startsWith('touch') && event.target === canvas) {
        // A native TouchEvent lists touches on the whole document, even when the
        // second touch's own event was stopped at our toolbar. Unity simulates
        // mouse buttons from touch count, so give its listener canvas touches only.
        // Keep the original trusted event and Touch objects; do not dispatch events.
        for (const property of ['touches', 'targetTouches', 'changedTouches']) {
          const original = event[property];
          const filtered = [...original].filter(touch => touch.target === canvas);
          if (filtered.length !== original.length) {
            Object.defineProperty(filtered, 'item', { value: index => filtered[index] || null });
            Object.defineProperty(event, property, { configurable: true, value: filtered });
          }
        }
        return;
      }
      // A native mouse drag starting on the canvas must receive its release even
      // when its pointer ends over the bar. Toolbar-owned presses are separate.
      if (nativeMouseHeld && ['mousedown', 'mousemove', 'mouseup'].includes(type)) {
        if (type === 'mouseup') nativeMouseHeld = false;
        return;
      }
      if (inside(event)) consume(event);
    }, { capture: true, passive: false });
  }
  window.addEventListener('click', event => {
    if (!inside(event)) return;
    const button = buttonFor(event);
    // Assistive technology may invoke click directly without pointer/key events.
    if (button && event.detail === 0) send('PulseAction', button.dataset.gameAction);
    consume(event);
  }, true);
  window.addEventListener('keydown', event => {
    if (!inside(event) || !['Enter', 'Space'].includes(event.code)) return;
    const button = buttonFor(event);
    if (button) press(`key:${event.code}`, button.dataset.gameAction);
    consume(event);
  }, true);
  window.addEventListener('keyup', event => {
    const source = `key:${event.code}`;
    if (!active.has(source)) return;
    release(source);
    consume(event);
  }, true);
})();
