:root { color-scheme: dark; --ink: #111714; --paper: #f2eee1; --muted: #a6b3a8; --accent: #efc382; --edge: #485b4d; --viewport-height: 100dvh; font: 16px/1.5 system-ui, sans-serif; }
* { box-sizing: border-box; }
html, body { margin: 0; width: 100%; height: 100%; overflow: hidden; overscroll-behavior: none; background: var(--ink); color: var(--paper); }
button, summary { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }
button { min-height: 44px; padding: .65rem 1.2rem; border: 1px solid var(--accent); border-radius: 3px; background: var(--accent); color: var(--ink); font: inherit; font-weight: 650; cursor: pointer; }
button:disabled { opacity: .55; cursor: default; }
button:focus-visible, summary:focus-visible, canvas:focus-visible { outline: 3px solid var(--paper); outline-offset: 3px; }
[hidden] { display: none !important; }
#game-frame { position: fixed; inset: 0; height: var(--viewport-height); padding: env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left); }
#unity-canvas { display: block; width: 100%; height: 100%; background: var(--ink); touch-action: none; -webkit-user-select: none; user-select: none; }
@media (orientation: landscape) { .stretch-game #game-frame { padding: 0; } }
#launch-panel { position: fixed; inset: 0; display: grid; place-items: center; overflow-y: auto; padding: max(1.5rem, env(safe-area-inset-top)) max(1.5rem, env(safe-area-inset-right)) max(4.5rem, env(safe-area-inset-bottom)) max(1.5rem, env(safe-area-inset-left)); background: var(--ink); }
.launch-content { width: min(100%, 30rem); }
.eyebrow { color: var(--muted); font: 600 .65rem/1.6 ui-monospace, monospace; letter-spacing: .14em; }
h1 { margin: 1rem 0; font: 900 clamp(2.5rem, 8vw, 4.8rem)/.91 ui-monospace, monospace; letter-spacing: -.06em; }
h1 span { color: var(--accent); }
#load-status { min-height: 1.5em; }
#load-progress { display: block; width: 100%; height: .55rem; margin: 1rem 0; accent-color: var(--accent); }
#offline-progress { width: 100%; height: .75rem; accent-color: var(--accent); }
#offline-transfer { font-variant-numeric: tabular-nums; color: var(--accent); }
#load-error-details { margin-top: .75rem; }
#load-error-message { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .75rem; max-height: 8rem; overflow: auto; }
#startup-report { white-space: pre-wrap; overflow-wrap: anywhere; font-size: .75rem; max-height: 9rem; overflow: auto; user-select: text; }
.hint { max-width: 34rem; font-size: .8rem; color: var(--muted); }
#orientation-tip { position: fixed; bottom: max(.6rem, env(safe-area-inset-bottom)); left: max(1rem, env(safe-area-inset-left)); right: max(1rem, env(safe-area-inset-right)); margin: 0; text-align: center; background: #111714e8; color: var(--paper); font-size: .8rem; pointer-events: none; padding: .5rem; }
#app-menu { position: fixed; top: max(.5rem, env(safe-area-inset-top)); left: max(.5rem, env(safe-area-inset-left)); z-index: 5; max-width: min(23rem, calc(100vw - 2rem)); }
#app-menu summary { list-style: none; min-height: 44px; display: grid; align-items: center; padding: .5rem .8rem; margin-right: auto; width: max-content; border: 1px solid var(--edge); border-radius: 3px; background: #111714e8; cursor: pointer; font-size: .8rem; }
#app-menu summary::-webkit-details-marker { display: none; }
.menu-content { background: var(--ink); border: 1px solid var(--edge); padding: 1rem; max-height: calc(var(--viewport-height) - 6rem); overflow-y: auto; box-shadow: 0 10px 40px #0009; }
.menu-content p:first-child { margin-top: 0; }
.menu-content p { font-size: .85rem; }
.menu-content button { width: 100%; }
.graphics-settings { margin: 0 0 1rem; padding: 0 0 1rem; border: 0; border-bottom: 1px solid var(--edge); }
.graphics-settings legend { font-weight: 700; color: var(--accent); margin-bottom: .5rem; }
.graphics-settings label { display: block; margin: .5rem 0 .25rem; font-size: .85rem; }
.graphics-settings select { width: 100%; min-height: 44px; padding: .5rem; font: inherit; color: var(--paper); background: #1d2920; border: 1px solid var(--edge); border-radius: 3px; }
@media (orientation: landscape) { #orientation-tip { display: none; } }
@media (max-height: 480px) and (orientation: landscape) { .launch-content { width: min(75%, 40rem); } h1 { font-size: 2.8rem; margin: .4rem 0; } h1 br { display: none; } h1 span::before { content: ' '; } .eyebrow, .hint { margin: .5rem 0; } #launch-panel { padding-bottom: 1.2rem; } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
:root { --controls-height: calc(64px + env(safe-area-inset-bottom)); }
.has-mobile-controls #game-frame { height: calc(var(--viewport-height) - var(--controls-height)); padding-bottom: 0; }
#mobile-controls { position: fixed; z-index: 4; left: 0; right: 0; top: calc(var(--viewport-height) - var(--controls-height)); height: var(--controls-height); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 4px; padding: 6px max(8px, env(safe-area-inset-right)) max(6px, env(safe-area-inset-bottom)) max(8px, env(safe-area-inset-left)); background: var(--ink); border-top: 1px solid var(--edge); touch-action: none; -webkit-user-select: none; user-select: none; }
#mobile-controls button { min-width: 44px; min-height: 44px; padding: 2px; font-size: 1.2rem; line-height: 1; background: #1d2920; border-color: var(--edge); color: var(--paper); touch-action: none; }
#mobile-controls button span { display: block; font-size: .65rem; line-height: 1.2; margin-top: 4px; }
#mobile-controls button svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; vertical-align: middle; }
#mobile-controls button[aria-pressed="true"] { background: var(--accent); color: var(--ink); border-color: var(--accent); }
.has-mobile-controls #orientation-tip { bottom: calc(var(--controls-height) + .4rem); }
.control-preference { min-height: 44px; display: flex; align-items: center; gap: .6rem; cursor: pointer; font-size: .85rem; }
.control-preference input { width: 20px; height: 20px; accent-color: var(--accent); }
#save-warning { position: fixed; z-index: 6; top: max(4rem, calc(env(safe-area-inset-top) + 3.5rem)); left: max(1rem, env(safe-area-inset-left)); width: min(34rem, calc(100vw - 2rem)); padding: 1rem; border: 2px solid var(--accent); border-radius: 3px; background: var(--ink); box-shadow: 0 8px 30px #0009; max-height: calc(var(--viewport-height) - 9rem); overflow-y: auto; }
#save-warning p { margin: 0 0 .75rem; font-size: .85rem; }
#save-warning button { min-height: 44px; font-size: .85rem; }
.visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
.save-tools { border-top: 1px solid var(--edge); margin-top: 1rem; padding-top: 1rem; }
.save-tools input { display: block; max-width: 100%; margin: .5rem 0; }
.backup-download { display: inline-block; padding: .75rem; color: var(--accent); }
.backup-download[hidden] { display: none; }
@media (orientation: landscape) and (min-height: 368px) {
  :root { --controls-width: calc(72px + env(safe-area-inset-right)); --controls-top: calc(50px + env(safe-area-inset-top)); }
  .has-mobile-controls #game-frame { width: calc(100% - var(--controls-width)); right: var(--controls-width); height: var(--viewport-height); padding-right: 0; padding-bottom: env(safe-area-inset-bottom); }
  #mobile-controls { left: auto; width: var(--controls-width); top: var(--controls-top); height: calc(var(--viewport-height) - var(--controls-top)); grid-template-columns: minmax(0, 1fr); grid-template-rows: repeat(6, minmax(0, 1fr)); padding-left: 8px; border-top: 0; border-left: 1px solid var(--edge); }
  .has-mobile-controls #app-menu { top: max(6px, env(safe-area-inset-top)); left: auto; right: max(8px, env(safe-area-inset-right)); width: 56px; }
  .has-mobile-controls #app-menu summary { width: 100%; min-height: 44px; padding: .2rem; text-align: center; font-size: .7rem; }
  .has-mobile-controls #app-menu[open] .menu-content { position: absolute; right: 0; top: 48px; width: min(23rem, calc(100vw - 2rem)); max-height: calc(var(--viewport-height) - 72px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); }
}
