(() => {
  'use strict';
  const key = 'probably-stolen-last-start-v1';
  let current = null, lastWrite = 0;
  let previous;
  try { previous = JSON.parse(localStorage.getItem(key)); } catch (_) { /* Optional diagnostics. */ }
  const panel = document.getElementById('startup-diagnostics');
  const text = document.getElementById('startup-report');
  function format(report) {
    if (!report || typeof report !== 'object') return 'Chưa có lần mở game trước.';
    return [
      `Bản: ${report.release || '?'}`,
      `Bộ game: ${report.build || '?'}`,
      `Lúc mở: ${report.started || '?'}`,
      `Bước cuối: ${report.phase || '?'}`,
      report.progress == null ? '' : `Tiến trình bước này: ${Math.round(report.progress * 100)}%`,
      report.heapBytes ? `Vùng nhớ Unity: ${Math.round(report.heapBytes / 1048576)} MiB` : '',
      report.error ? `Lỗi: ${report.error}` : '',
      `Trình duyệt: ${report.browser || '?'}`,
    ].filter(Boolean).join('\n');
  }
  function persist(force = true) {
    if (!current || (!force && Date.now() - lastWrite < 1000)) return;
    lastWrite = Date.now();
    try { localStorage.setItem(key, JSON.stringify(current)); } catch (_) { /* Gameplay does not depend on storage for diagnostics. */ }
  }
  text.textContent = format(previous);
  panel.hidden = !previous;
  document.getElementById('copy-startup-report').addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(text.textContent);
      document.getElementById('copy-startup-status').textContent = 'Đã sao chép thông tin.';
    } catch (_) { document.getElementById('copy-startup-status').textContent = 'Bạn có thể chọn và sao chép đoạn thông tin bên trên.'; }
  });
  function phase(name, progress = null) {
    if (!current) return;
    const changed = current.phase !== name;
    current.phase = name;
    current.progress = progress;
    persist(changed || progress === 1);
  }
  window.ProbablyStolenStartup = Object.freeze({
    phase,
    begin(build) {
      current = {release: 8, build, started: new Date().toISOString(), browser: navigator.userAgent, phase: 'Chuẩn bị khởi động'};
      persist();
    },
    fail(error) {
      if (!current) return;
      current.error = String(error?.message || error).slice(0, 1500);
      persist();
      text.textContent = format(current);
      panel.hidden = false;
      panel.open = true;
    },
    ready(player) {
      phase('Đã mở game');
      const update = () => {
        current.heapBytes = player.Module?.HEAPU8?.buffer.byteLength || 0;
        persist();
      };
      update();
      window.setInterval(update, 10000);
    },
  });
  window.addEventListener('error', event => {
    if (event.message) window.ProbablyStolenStartup.fail(event.error || event.message);
  });
  window.addEventListener('unhandledrejection', event => window.ProbablyStolenStartup.fail(event.reason));
  document.getElementById('unity-canvas').addEventListener('webglcontextlost', () => {
    window.ProbablyStolenStartup.fail('Trình duyệt mất kết nối với bộ xử lý đồ họa (WebGL context lost).');
  });
})();
