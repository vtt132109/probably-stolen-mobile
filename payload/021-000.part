(() => {
  'use strict';
  // Read verified parts directly into one destination buffer. Do not send a single
  // ~300 MB synthetic response through the service worker/browser stream bridge.
  function createDataFetcher(build, dataUrl) {
    const target = new URL(dataUrl, location.href);
    const file = build.virtualFiles?.find(file => new URL(file.url, location.href).href === target.href);
    if (!file) throw new Error('Bản tải thiếu danh sách các phần dữ liệu game. Đóng ứng dụng rồi mở lại khi có mạng.');
    const assets = new Map(build.files.map(file => [new URL(file.url, location.href).href, file]));
    const parts = file.parts.map(url => {
      const resolved = new URL(url, location.href), part = assets.get(resolved.href);
      if (resolved.origin !== location.origin || !part || !Number.isSafeInteger(part.responseBytes) ||
          part.responseBytes <= 0 || part.contentEncoding || !/^[a-f0-9]{64}$/.test(part.sha256))
        throw new Error('Danh sách phần dữ liệu game không hợp lệ.');
      return {...part, url:resolved.href};
    });
    if (!parts.length || !Number.isSafeInteger(file.responseBytes) || file.responseBytes <= 0 ||
        parts.reduce((sum, part) => sum + part.responseBytes, 0) !== file.responseBytes)
      throw new Error('Dung lượng các phần dữ liệu game không khớp.');

    async function readPart(part, index) {
      let failure;
      for (let attempt = 0; attempt < 3; attempt++) {
        const controller = new AbortController();
        const timer = setTimeout(() => controller.abort(), 90000);
        try {
          const response = await fetch(part.url, {credentials:'same-origin',
            cache:attempt ? 'reload' : 'default', signal:controller.signal});
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          const bytes = new Uint8Array(await response.arrayBuffer());
          if (bytes.length !== part.responseBytes) throw new Error(`Sai dung lượng: ${bytes.length}/${part.responseBytes} byte`);
          const digest = [...new Uint8Array(await crypto.subtle.digest('SHA-256', bytes))]
            .map(value => value.toString(16).padStart(2,'0')).join('');
          if (digest !== part.sha256) throw new Error('Dữ liệu không khớp mã kiểm tra SHA-256');
          return bytes;
        } catch (error) { failure = error; }
        finally { clearTimeout(timer); }
        if (attempt < 2) await new Promise(resolve => setTimeout(resolve, 250 * (attempt + 1)));
      }
      throw new Error(`Không đọc được phần dữ liệu ${index + 1}/${parts.length} (${part.path}) sau 3 lần: ${failure?.message || failure}`);
    }
    return async function fetchDataWithProgress(url, options = {}) {
      if (new URL(url, location.href).href !== target.href) throw new Error('Địa chỉ dữ liệu game không khớp bản tải.');
      let body;
      try { body = new Uint8Array(file.responseBytes); }
      catch (error) { throw new Error(`Không cấp phát được vùng dữ liệu ${Math.round(file.responseBytes / 1048576)} MiB: ${error.message}`); }
      const response = {headers:new Headers({'Content-Type':'application/octet-stream',
        'Content-Length':String(file.responseBytes)}), parsedBody:body};
      let loaded = 0;
      const progress = type => options.onProgress?.({type,response,total:body.length,loaded,
        lengthComputable:true,chunk:null});
      progress('progress');
      for (let index = 0; index < parts.length; index++) {
        const bytes = await readPart(parts[index], index);
        body.set(bytes, loaded);
        loaded += bytes.length;
        progress('progress');
      }
      progress('load');
      return response;
    };
  }
  window.ProbablyStolenDownloads = Object.freeze({createDataFetcher});
})();
